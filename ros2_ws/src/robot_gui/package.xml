<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_gui</name>
  <version>0.1.0</version>
  <description>IHM PySide6 du bras 6 axes : jumeau numérique 3D, contrôle, tableau de bord, caméra, rosbag, apprentissage.</description>
  <maintainer email="ahmedetude21@gmail.com">ahmed</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>robot_interfaces</depend>
  <depend>robot_kinematics</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <!-- PySide6, pyqtgraph et PyOpenGL s'installent avec pip : voir docs/INSTALLATION.md -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
