Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grille
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 10
    - Class: rviz_default_plugins/RobotModel
      Name: Robot (mesure)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 1
    - Class: rviz_default_plugins/RobotModel
      Name: Robot fantôme (consigne)
      Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /ghost/robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      TF Prefix: ghost
      Alpha: 0.35
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.15
      Show Names: false
    - Class: rviz_default_plugins/Pose
      Name: Cible (/target_pose)
      Enabled: true
      Topic:
        Value: /target_pose
        Depth: 5
        Reliability Policy: Reliable
      Shape: Axes
      Axes Length: 0.08
      Axes Radius: 0.006
    - Class: rviz_default_plugins/Pose
      Name: Effecteur (FK)
      Enabled: true
      Topic:
        Value: /end_effector_pose
        Depth: 1
        Reliability Policy: Best Effort
      Shape: Axes
      Axes Length: 0.06
      Axes Radius: 0.004
  Global Options:
    Fixed Frame: base_link
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0.4
      Pitch: 0.5
      Yaw: 0.8
