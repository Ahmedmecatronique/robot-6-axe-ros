<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.1.0</version>
  <description>Fichiers launch et paramètres du bras 6 axes : Raspberry Pi (réel), PC (IHM), simulation.</description>
  <maintainer email="ahmedetude21@gmail.com">ahmed</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_description</exec_depend>
  <exec_depend>robot_kinematics</exec_depend>
  <exec_depend>robot_control</exec_depend>
  <exec_depend>robot_vision</exec_depend>
  <exec_depend>robot_gui</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <!-- micro_ros_agent est installé à part (voir docs/INSTALLATION.md) -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
